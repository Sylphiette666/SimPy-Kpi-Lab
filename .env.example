# Never commit the real key.
OPENAI_API_KEY=your_api_key_here
SIMLAB_OPENAI_MODEL=gpt-5.6

# Optional local control-plane settings. Replace the token before starting the API.
SIMLAB_API_TOKEN=replace_with_a_long_random_value
SIMLAB_API_OUTPUT_ROOT=outputs/api_sessions
SIMLAB_API_URL=http://127.0.0.1:8000
